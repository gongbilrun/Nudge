{
  "name": "nudge",
  "version": "1.0.0",
  "description": "항상 위에 떠있는 일정 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.nudge.app",
    "productName": "Nudge",
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "mac": { "target": "dmg", "icon": "assets/icon.icns", "category": "public.app-category.productivity" },
    "nsis": { "oneClick": true, "perMachine": false }
  },
  "dependencies": {
    "electron-store": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
